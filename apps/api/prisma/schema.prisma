generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PayoutStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum VideoStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  REJECTED
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  email          String           @unique
  passwordHash   String
  displayName    String
  role           Role             @default(VIEWER)
  countryCode    String           @db.VarChar(2)
  status         UserStatus       @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       Session[]
  creatorProfile CreatorProfile?
  videos         Video[]

  @@index([status, createdAt])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CreatorProfile {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @db.Uuid
  handle       String       @unique
  displayName  String
  bio          String       @default("")
  payoutStatus PayoutStatus @default(UNVERIFIED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CountryPolicy {
  id                   String   @id
  signupEnabled        Boolean
  creatorUploadsEnabled Boolean
  adsEnabled           Boolean
  payoutsEnabled       Boolean
  dataRegion           String   @default("global")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Video {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @db.Uuid
  title       String
  description String
  status      VideoStatus     @default(UPLOADING)
  visibility  VideoVisibility @default(PUBLIC)
  fileName    String
  mimeType    String
  sizeBytes   BigInt
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uploadSession UploadSession?

  @@index([ownerId, status])
  @@index([ownerId, createdAt])
}

model UploadSession {
  id              String    @id @default(uuid()) @db.Uuid
  videoId         String    @unique @db.Uuid
  objectKey       String    @unique
  uploadTokenHash String    @unique @db.VarChar(64)
  expiresAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  video           Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
