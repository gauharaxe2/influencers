# Copy to apps/api/.env for local API development.
# Blank values are ignored. Development defaults apply when NODE_ENV is not production.
# Do not put real secrets in this file. See DEPLOYMENT.md.

NODE_ENV=
PORT=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=
MAX_UPLOAD_BYTES=
PUBLIC_API_URL=
WEB_ORIGIN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=
