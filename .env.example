# Copy to .env only for local experiments at the repo root.
# The API reads apps/api/.env. The web app reads apps/web/.env.local.
# Leave a line blank, or delete it, to use the development default.
# Fill secrets only in Vercel or a local untracked env file. See DEPLOYMENT.md.

NODE_ENV=
PORT=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=
MAX_UPLOAD_BYTES=
PUBLIC_API_URL=
WEB_ORIGIN=
API_INTERNAL_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=
